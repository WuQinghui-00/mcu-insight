{
  "metrics": {
    "custom.light_sleep_pct": {
      "unit": "%",
      "description": "share of wall time the chip spent in light sleep; it collapses when a task polls instead of blocking"
    }
  },
  "rules": [
    {"metric": "heap.free", "min_rate_per_s": -64, "min_span_ms": 60000},
    {"metric": "heap.min", "min": 100000, "stat": "min"},
    {"metric": "task.*.stack_free_min", "min": 384, "stat": "min"},
    {"metric": "custom.light_sleep_pct", "min": 50, "stat": "last", "min_samples": 15}
  ]
}